# Acme Loan Processor Environment Configuration
#
# Copy to .env and fill in values:
#   cp .env.example .env

# OpenRouter API Key (required for LLM features)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OpenRouter Model (required)
# See available models at: https://openrouter.ai/models
OPENROUTER_MODEL=meta-llama/llama-3.1-70b-instruct

# Optional: vision-capable OpenRouter model used to transcribe visible text
# in uploaded images (falls back to OPENROUTER_MODEL if unset - only needed
# if that model isn't multimodal). e.g. openai/gpt-4o-mini, google/gemini-2.0-flash-001
OPENROUTER_VISION_MODEL=

# JWT Secret (used after Unifai remediation for agent auth)
JWT_SECRET=change-me

# Backend URL (for frontend to connect)
BACKEND_URL=http://127.0.0.1:5500

# Optional: Logging level
LOG_LEVEL=INFO
