# Acme Loan Processor Environment Configuration
#
# Copy to .env and fill in values:
#   cp .env.example .env

# OpenRouter API Key (required for LLM features)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OpenRouter Model (required)
# Use a multimodal model for the image diagnostics demo
# (e.g. meta-llama/llama-4-scout). See: https://openrouter.ai/models
OPENROUTER_MODEL=meta-llama/llama-4-scout

# LLM Provider (optional, defaults to "openrouter")
# Set to "ollama" to route agent LLM calls through a local Ollama server
# instead of OpenRouter.
LLM_PROVIDER=ollama

# Ollama Base URL (used only when LLM_PROVIDER=ollama)
# Ollama exposes an OpenAI-compatible API at this path by default.
OLLAMA_BASE_URL=http://localhost:11434/v1

# Ollama Model (used only when LLM_PROVIDER=ollama)
# Must already be pulled locally, e.g. `ollama pull llama3.1`.
OLLAMA_MODEL=llama3.1

# Ollama API Key (optional; Ollama does not require auth by default)
OLLAMA_API_KEY=

# JWT Secret (used after Unifai remediation for agent auth)
JWT_SECRET=change-me

# Backend URL (for frontend to connect)
BACKEND_URL=http://127.0.0.1:5500

# Optional: Logging level
LOG_LEVEL=INFO

# Lineaje GR Service — guardrail stub runtime configuration
# Fill in GR_SERVICE_URL with your running GR service address.
GR_SERVICE_URL=https://mcp.commercialdev.dev.veedna.com/enforce

LINEAJE_REFRESH_
